# Render Environment > Add from .env에 넣을 형식. 비밀값은 Git에 저장하지 마세요.
SECRET_KEY=
# Supabase Connect > Shared Pooler > Transaction. 프로젝트 DB 비밀번호 사용.
DATABASE_URL=
SUPABASE_URL=
# 서버용 Secret key (또는 기존 service_role key). anon/publishable 키가 아닙니다.
SUPABASE_KEY=
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Brevo에서 인증한 발신 이메일 주소
MAIL_FROM=
SESSION_COOKIE_SECURE=1
