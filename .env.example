SECRET_KEY=replace-with-a-long-random-secret
SUPABASE_URL=
SUPABASE_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
# HTTPS 배포 시 1로 설정 (로컬 HTTP에서는 0)
SESSION_COOKIE_SECURE=0
# 기본값: 프로젝트의 instance/market.sqlite3 (한 서버의 모든 워커가 공유)
# MARKET_DATABASE=/absolute/persistent/path/market.sqlite3
# 무료 Render: .env.render.example 참고. DATABASE_URL 지정 시 PostgreSQL 사용.
DATABASE_URL=
# 로컬 기존 Gmail: smtp / 무료 Render: brevo 또는 resend
EMAIL_PROVIDER=smtp
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
